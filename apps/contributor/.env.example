# Public browser-safe values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BLOG_URL=https://omnilede.example
NEXT_PUBLIC_CONTRIBUTOR_URL=https://contributors.omnilede.example
AUTH_ALLOWED_ORIGINS=https://contributors.omnilede.example
AUTH_RATE_LIMIT_SALT=replace-with-a-long-random-server-secret

# Server-only values. Configure these in Netlify, never in client code.
SUPABASE_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_TEXT_MODEL=
CLOUDFLARE_IMAGE_MODEL=
CLOUDFLARE_EMBEDDING_MODEL=
TAVILY_API_KEY=
BREVO_API_KEY=
BLOG_PUBLISH_URL=https://omnilede.example/api/internal/publications
BLOG_PUBLISH_HMAC_SECRET=
PUBLISHED_IMAGE_ORIGIN=https://your-project.supabase.co/storage/v1/object/public/published-images
PUBLICATION_INTERNAL_SECRET=replace-with-at-least-32-random-characters
PUBLICATION_CRON_SECRET=replace-with-at-least-32-random-characters
TURNSTILE_SECRET_KEY=
REDEMPTIONS_ENABLED=false
ALLOW_FUNDED_REDEMPTIONS=false

# Create/login to Cloudflare, Tavily, and Brevo manually on their free tiers.
# Quota exhaustion routes submissions to manual review; it never upgrades billing.
