# Public browser-safe values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BLOG_URL=https://omnilede.example
NEXT_PUBLIC_CONTRIBUTOR_URL=https://contributors.omnilede.example
NEXT_PUBLIC_STUDIO_URL=https://studio.omnilede.example

# Server-only read/health values. Configure these in Netlify, never in client code.
SUPABASE_SECRET_KEY=
GITHUB_REPOSITORY=Rickysharan/blog
GITHUB_READ_TOKEN=
GITHUB_CONTENT_BRANCH=
GITHUB_CONTENT_TOKEN=
NETLIFY_ACCOUNT_SLUG=rickysharan999
NETLIFY_READ_TOKEN=
BLOG_NETLIFY_SITE_ID=
CONTRIBUTOR_NETLIFY_SITE_ID=
HEALTH_INGEST_HMAC_SECRET=
STUDIO_OPERATOR_EMAIL=operator@example.com
AUTH_ALLOWED_ORIGINS=https://studio.omnilede.example

# Server-only Google OAuth values. Generate the encryption key locally with:
# openssl rand -base64 32
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_REDIRECT_URI=https://studio.omnilede.example/api/connections/google/callback
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://omnilede.example/

# GITHUB_CONTENT_TOKEN is a fine-grained token limited to GITHUB_REPOSITORY, with
# Contents read/write access. Protect GITHUB_CONTENT_BRANCH with the repository's
# review policy; do not grant organization-wide or unrelated repository access.
# GitHub read and Netlify tokens remain read-only.
