+  process.cwd(),
+  "supabase/migrations/202610020001_studio_control_plane.sql"
+);
+
+function migrationSql() {
+  return readFileSync(migrationPath, "utf8").replace(/\s+/g, " ").toLowerCase();
+}
+
+describe("Studio control-plane migration", () => {
