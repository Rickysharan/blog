# Public site identity (the exact localhost value is allowed for development only)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form storage, abuse control, and optional free-tier Brevo notification
CONTACT_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
CONTACT_NOTIFICATION_TO=
CONTACT_COMMERCIAL_NOTIFICATION_TO=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=OmniLede

# Signed contributor publication receiver (server-only)
CONTRIBUTOR_PUBLISH_HMAC_SECRET=replace-with-at-least-32-random-characters
GITHUB_PUBLISH_TOKEN=replace-with-a-fine-grained-github-token
PUBLISHED_IMAGE_ORIGIN=https://project-id.supabase.co/storage/v1/object/public/published-images
CONTRIBUTOR_APP_ORIGIN=https://contributors.example
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-service-key

# Admin authentication
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# GitHub-backed production moderation
GITHUB_REPOSITORY=owner/repository
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Optional AI drafting (disabled by default)
# Anthropic API use may incur provider charges; the site and manual MDX workflow do not require it.
DRAFT_GENERATION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Free-tier market data
STOCK_API_KEY=

# Consent-gated integrations
GA4_ID=
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_IN_FEED=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_FOOTER=
# Keep false until Google approval, the exact ads.txt seller record, approved slot IDs,
# consent review, and commercial hosting terms are ready.
ADSENSE_ENABLED=false

# Optional Vercel cron
CRON_SECRET=replace-with-at-least-16-random-characters
